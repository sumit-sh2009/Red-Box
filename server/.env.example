PORT=3001
JWT_SECRET=change_me_in_production
DATABASE_URL=postgres://civic:civic@localhost:5432/civicpulse
AI_SERVICE_URL=http://127.0.0.1:8001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
GROQ_MODERATION_MODEL=openai/gpt-oss-safeguard-20b

# Ollama local fallback (auto-probed unless OLLAMA_ENABLED=false)
OLLAMA_ENABLED=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# OpenRouter cloud fallback — free :free models need an API key from openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_SUMMARY_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODERATION_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_APP_NAME=CivicPulse
